rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && me().data.admin == true; }
    function isEmp() { return hasProfile() && me().data.get('role', '') == 'employee'; }
    function staff() { return hasProfile() && !isEmp(); }
    function initialized() { return exists(/databases/$(database)/documents/meta/initialized); }

    // الحسابات: المدير يدير الجميع، والمستخدم يقرأ ملفه ويحدّث تفضيلاته فقط
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // إنشاء أول مدير مرة واحدة فقط (قبل وجود meta/initialized)
      allow create: if (signedIn() && request.auth.uid == uid && !initialized()
                        && request.resource.data.admin == true)
                    || isAdmin();
      // المستخدم يحدّث تفضيلاته وجلسته، ويربط هاتفه مرة واحدة فقط (لا يغيّره بعد الربط؛ المدير وحده يعيد ضبطه)
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs', 'session', 'deviceId'])
                        && (resource.data.get('deviceId', '') == ''
                            || request.resource.data.get('deviceId', '') == resource.data.get('deviceId', '')));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // علامة التهيئة: تُنشأ مرة واحدة مع أول مدير ولا تُعدَّل بعدها
    match /meta/initialized {
      allow read: if signedIn();
      allow create: if signedIn() && !initialized() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // إعدادات البصمة: يقرؤها الموظف (نطاق جغرافي وورديات فقط)، ويكتبها الموظفون الإداريون
    match /punchcfg/main {
      allow read: if hasProfile();
      allow write: if staff();
    }

    // قائمة أسماء الموظفين لشاشة الدخول: قراءة عامة (أسماء وأسماء مستخدمين فقط)، والكتابة للإداريين
    // نسخة حساب الدخول لكل مستخدم (تتغير عند تغيير المدير لكلمة سره)
    match /loginlist/ver {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /loginlist/main {
      allow read: if true;
      allow write: if staff();
    }

    // البصمات: الموظف يُنشئ بصمته هو فقط، والوقت = وقت الخادم، ولا يعدّل ولا يحذف
    match /punches/{id} {
      // بصمة حضور واحدة وبصمة انصراف واحدة لكل يوم: رقم المستند ثابت فيُرفض التكرار
      allow create: if isEmp()
        && id == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.type
        && request.resource.data.keys().hasOnly(['uid','empId','type','day','lat','lng','acc','dist','applied','dev','sid','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().data.empId
        && request.resource.data.type in ['in','out']
        && request.resource.data.applied == false
        && me().data.get('deviceId', '') != ''
        && request.resource.data.dev == me().data.get('deviceId', '')
        && request.resource.data.sid == me().data.session.id
        && request.resource.data.ts == request.time;
      allow read: if staff() || (isEmp() && resource.data.uid == request.auth.uid);
      allow update: if staff();
      allow delete: if staff();
    }

    // سجل التدقيق: يُضاف من المستخدمين الإداريين، ويقرأه المدير فقط، ولا يُعدَّل ولا يُحذف
    match /audit/{id} {
      allow create: if staff() && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // بقية بيانات النظام: للمستخدمين الإداريين فقط (ليس لحسابات الموظفين)
    match /{col}/{id} {
      allow read, write: if staff()
        && col in ['meta', 'emps', 'att', 'adv', 'bon', 'sett', 'pay', 'efiles']
        && !(col == 'meta' && id == 'initialized');
    }
  }
}
